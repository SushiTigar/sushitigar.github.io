---
interface Props {
  about: string;
}

const { about } = Astro.props;
---

<section id="about">
  <div class="container about-section">
    <div class="about-content">
      <h2>About Me</h2>
      <p class="about-text">{about}</p>
    </div>
    <div class="about-avatar">
      <img src="/images/profile.png" alt="Sushiil Shettigar" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .about-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .about-text {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .about-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-avatar img {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 768px) {
    .about-section {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-avatar {
      order: -1;
    }

    .about-avatar img {
      width: 180px;
      height: 180px;
    }
  }
</style>
